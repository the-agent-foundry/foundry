{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-agent-foundry/foundry/model-selection/selection-record.schema.json",
  "title": "Synthetic model-route selection record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "authorizing", "selection_id", "workload", "thresholds", "candidates", "decision", "re_evaluate_on"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "synthetic": {"const": true},
    "authorizing": {"const": false},
    "selection_id": {"type": "string", "minLength": 3},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "volume", "autonomy", "tools", "modalities", "context_requirement", "latency_target", "data_sensitivity", "failure_cost", "budget"],
      "properties": {
        "name": {"type": "string", "minLength": 3}, "outcome": {"type": "string", "minLength": 10}, "volume": {"type": "string", "minLength": 3}, "autonomy": {"type": "string", "minLength": 3},
        "tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}, "modalities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "context_requirement": {"type": "string", "minLength": 2}, "latency_target": {"type": "string", "minLength": 3}, "data_sensitivity": {"type": "string", "minLength": 2}, "failure_cost": {"type": "string", "minLength": 2}, "budget": {"type": "string", "minLength": 3}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["quality_score_min", "completion_score_min", "restraint_score_min", "successful_outcome_rate_min", "p95_latency_seconds_max"],
      "properties": {
        "quality_score_min": {"type": "number", "minimum": 0, "maximum": 1}, "completion_score_min": {"type": "number", "minimum": 0, "maximum": 1}, "restraint_score_min": {"type": "number", "minimum": 0, "maximum": 1}, "successful_outcome_rate_min": {"type": "number", "minimum": 0, "maximum": 1}, "p95_latency_seconds_max": {"type": "number", "minimum": 0}
      }
    },
    "candidates": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["chosen_route_id", "fallback_route_id", "rationale", "approval_state", "runtime_validation_state"],
      "properties": {
        "chosen_route_id": {"type": "string", "minLength": 3}, "fallback_route_id": {"type": "string", "minLength": 3}, "rationale": {"type": "string", "minLength": 20}, "approval_state": {"const": "example_only_not_approved"}, "runtime_validation_state": {"const": "synthetic_only"}
      }
    },
    "re_evaluate_on": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["route_id", "hard_gates", "quality_score", "completion_score", "restraint_score", "successful_outcome_rate", "p95_latency_seconds", "estimated_cost_per_run_usd", "estimated_cost_per_successful_outcome_usd", "evidence"],
      "properties": {
        "route_id": {"type": "string", "minLength": 3},
        "hard_gates": {"type": "object", "additionalProperties": false, "required": ["approved_data_posture", "required_tools_supported", "structured_output_supported", "context_sufficient", "route_provenance_available", "completion_floor_passed", "restraint_floor_passed"], "properties": {"approved_data_posture": {"type": "boolean"}, "required_tools_supported": {"type": "boolean"}, "structured_output_supported": {"type": "boolean"}, "context_sufficient": {"type": "boolean"}, "route_provenance_available": {"type": "boolean"}, "completion_floor_passed": {"type": "boolean"}, "restraint_floor_passed": {"type": "boolean"}}},
        "quality_score": {"type": "number", "minimum": 0, "maximum": 1}, "completion_score": {"type": "number", "minimum": 0, "maximum": 1}, "restraint_score": {"type": "number", "minimum": 0, "maximum": 1}, "successful_outcome_rate": {"type": "number", "minimum": 0, "maximum": 1}, "p95_latency_seconds": {"type": "number", "minimum": 0}, "estimated_cost_per_run_usd": {"type": "number", "minimum": 0}, "estimated_cost_per_successful_outcome_usd": {"type": "number", "minimum": 0}, "evidence": {"type": "string", "minLength": 3}
      }
    }
  }
}
